# Copia este archivo a infra/.env (está en .gitignore) y rellénalo. NUNCA lo subas a git.
# Lo carga infra/tf antes de ejecutar Terraform.

# --- GCP: proyecto y cuenta PERSONAL propietaria (infra/tf comprueba que el login coincide) ---
TF_VAR_gcp_project_id=
TF_GOOGLE_ACCOUNT=

# --- Supabase: token personal (Dashboard > Account > Access Tokens) y slug de tu organización personal ---
SUPABASE_ACCESS_TOKEN=
TF_VAR_supabase_organization_id=
# Ref del proyecto creado en el panel de Supabase (está en su URL: supabase.com/dashboard/project/<ref>)
TF_VAR_supabase_project_ref=

# --- Login con Google: se rellenan después de crear el cliente OAuth (ver infra/README.md) ---
TF_VAR_google_client_id=
TF_VAR_google_client_secret=
