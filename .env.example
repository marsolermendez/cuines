# Copia este archivo a .env.local y rellénalo.
# Local: los valores los imprime `npm run db:start` (supabase start).
# Producción: Panel de Supabase > Project Settings > API.
# La clave anon es pública por diseño (la protege la RLS). NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
